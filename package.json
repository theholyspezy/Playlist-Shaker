{
  "name": "playlist-shaker",
  "version": "1.0.0",
  "description": "Party Shaker 2000 - Winamp-style Spotify party playlist manager",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "npx --no -- electron-builder --win --x64"
  },
  "build": {
    "appId": "com.partyshaker.app",
    "productName": "Party Shaker 2000",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!node_modules/.cache",
      "!dist"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1"
  }
}
